# USE FIRST environment configuration
# Copy to .env.local for development.

# Public origin used for invitation links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Directory for the embedded PGlite PostgreSQL data (default: ./data/pglite)
PGLITE_DATA_DIR=./data/pglite

# Session lifetime in days
SESSION_TTL_DAYS=30

# Force Secure session cookies. Leave unset to auto-detect HTTPS.
# COOKIE_SECURE=true

# Set to "true" to seed a development-only demo household on first run.
# NEVER enable in production.
SEED_DEMO=false
